# Supabase public values — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Recommended current key (sb_publishable_...). The app also accepts the legacy ANON key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key

# Supabase server-only secret — NEVER add NEXT_PUBLIC_ to this variable
SUPABASE_SECRET_KEY=sb_secret_your_key
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key

# OpenAI-compatible provider — server only
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=1
OPENAI_VISION_MODEL=gpt-4o-mini

# Fast free voice pipeline — server only
# Groq: fast text + multilingual Whisper transcription
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Fish Audio: multilingual speech generation with its free model
FISH_AUDIO_API_KEY=
FISH_AUDIO_TTS_MODEL=fish-audio/s2.1-pro-free
FISH_AUDIO_VOICE=

# Meta WhatsApp Business Cloud API — server only
META_GRAPH_API_VERSION=v22.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=choose-a-long-random-value
META_APP_SECRET=
WHATSAPP_DEFAULT_MODE=copilot

# Billing — optional for the initial deployment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
